#!/command/with-contenv bash
# shellcheck shell=bash disable=SC1091,SC2076

source /scripts/common

SDIR=/etc/s6-overlay/finish.d

# exit 0 for nonexistent or empty directory
if ! [[ -d "$SDIR" ]] || [[ -z "$(ls "$SDIR")" ]]; then
    exit 0
fi

cd "$SDIR" || exit 1

for NAME in *; do
    s6wrap --quiet --prepend="$NAME" --timestamps --args "$SDIR/$NAME"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        s6wrap --quiet --prepend=startup --timestamps --args echo Error running "$SDIR/$NAME"
        # Propagate rather than flattening to 1: a child that exits 78 is
        # declaring an expected environmental failure, and collapsing that to 1
        # would turn a declared condition into an apparent fault.
        exit "$rc"
    fi
done
